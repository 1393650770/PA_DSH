{
  "name": "pa-mcp-dsh-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness 原生插件：把 PA_MCP(Python 全栈 A 股量化 MCP server)的 111 个工具以原生工具自动注册进 ctx.tools。插件 spawn 常驻 PA_MCP 进程并经 MCP 协议转发调用——改 PA_MCP 只改 python 侧，插件启动自动发现全部工具，无需手动同步。",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pack:check": "npm pack --dry-run",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "mcp",
    "a-share",
    "quant",
    "pa-mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}

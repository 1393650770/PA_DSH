{
  "name": "pa-mcp-dsh-sample",
  "version": "0.1.0",
  "description": "DeepSeek Harness 原生工具插件样例：不经 MCP，用 defineTool 把 PA_MCP(Python 量化数据层) 的行情/持仓/风控预检暴露给 dsh agent（node 侧 spawn python bridge）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/bridge.py",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bridge:smoke": "python scripts/bridge.py --tool positions",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
